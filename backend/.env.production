# Production Environment Variables for Railway
# Copy these to Railway dashboard

# Database
DATABASE_URL=postgresql://postgres:pbaoccjhrCDnvzqzFejNppmjlJJlpJPd@crossover.proxy.rlwy.net:13181/railway

# Environment
NODE_ENV=production
PORT=3000

# Frontend URL (Netlify)
FRONTEND_URL=https://listingsiq.netlify.app

# JWT Secret (CHANGE THIS IN RAILWAY!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Stripe (Add your keys in Railway)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Email (Add SendGrid API key in Railway)
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=noreply@listingsiq.com

# Google OAuth (Add in Railway)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://your-backend-url.railway.app/api/v1/auth/google/callback

# Yelp API (Add in Railway)
YELP_API_KEY=your_yelp_api_key

# Redis (Optional - use Railway/Render Redis addon)
# If not configured, application will run without job queue processing
# For Railway: Add Redis plugin from dashboard, it will auto-populate these vars
# For Render: Create Redis instance and set REDIS_HOST to internal hostname
# Leave as 'localhost' if not using Redis - app will gracefully skip Redis features
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# Gemini AI (Optional)
GEMINI_API_KEY=your_gemini_api_key

# Database Pool
DATABASE_POOL_SIZE=20
