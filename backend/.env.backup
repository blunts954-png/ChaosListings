DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
# Environment
NODE_ENV=development
PORT=3000

# Database
DATABASE_POOL_SIZE=20

#gemini
# SECURITY: Old API key was rotated on 2026-01-19 due to exposure
# Get new key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# JWT
JWT_SECRET=your-super-secret-key-change-in-production-use-openssl-rand-base64-32
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d

# Yext - Get from https://www.yext.com/s/me/apps
YEXT_API_KEY=your_yext_api_key_here
YEXT_ACCOUNT_ID=your_yext_account_id_here
YEXT_API_URL=https://api.yext.com/v2
YEXT_WEBHOOK_SECRET=your_webhook_secret_here

# Stripe - Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_LISTINGS_PRICE_ID=price_your_price_id_here

# URLs
FRONTEND_URL=http://localhost:3001
API_URL=http://localhost:3000

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Sentry
SENTRY_DSN=your_sentry_dsn_here

# Logging
LOG_LEVEL=debug
