# ===================================
# ChaosListings Environment Variables
# ===================================

# ===== DATABASE =====
DATABASE_URL="postgresql://chaoslistings:password@localhost:5432/chaoslistings"
DB_USER="chaoslistings"
DB_PASSWORD="password"
DB_NAME="chaoslistings"

# ===== REDIS =====
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""
REDIS_TLS="false"

# ===== SERVER =====
NODE_ENV="development"
PORT="3000"
LOG_LEVEL="debug"

# ===== AUTHENTICATION =====
JWT_SECRET="your-super-secret-jwt-key-change-me-in-production-min-32-chars!"
JWT_EXPIRATION="7d"

# ===== STRIPE =====
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe Product IDs (create these in Stripe Dashboard)
STRIPE_LISTINGS_STARTER_PLAN_ID="price_..."
STRIPE_LISTINGS_PROFESSIONAL_PLAN_ID="price_..."
STRIPE_LISTINGS_ENTERPRISE_PLAN_ID="price_..."

# ===== YEXT =====
YEXT_API_KEY="your-yext-api-key"
YEXT_ACCOUNT_ID="your-yext-account-id"
YEXT_ENVIRONMENT="production"  # or "sandbox" for testing

# ===== FREE LISTINGS APIS (Cost: $0) =====
# Google My Business - Free tier: unlimited locations
# Get credentials: https://console.cloud.google.com/
# Create OAuth 2.0 credentials (Desktop app)
GOOGLE_BUSINESS_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_BUSINESS_CLIENT_SECRET="your-google-client-secret"

# Yelp Business API - Free tier: 5,000 calls/day
# Get API key: https://www.yelp.com/developers/v3/manage_app
YELP_API_KEY="your-yelp-api-key"

# ===== EMAIL SERVICE =====
EMAIL_PROVIDER="smtp"  # Options: "smtp", "sendgrid"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_SECURE="false"
EMAIL_FROM="noreply@chaoslistings.com"

# Alternative: SendGrid
SENDGRID_API_KEY="sg_..."

# ===== FRONTEND =====
FRONTEND_URL="http://localhost:3001"

# ===== ERROR TRACKING =====
SENTRY_DSN="https://...@sentry.io/..."
SENTRY_ENVIRONMENT="development"

# ===== OPENAI / GEMINI (for AI features) =====
OPENAI_API_KEY="sk-..."
GEMINI_API_KEY="your-gemini-api-key"

# ===== CORS =====
CORS_ORIGIN="http://localhost:3001"

# ===== RATE LIMITING =====
THROTTLE_TTL="60000"  # milliseconds
THROTTLE_LIMIT="100"  # requests per TTL

# ===== WORKER SETTINGS =====
WORKER_CONCURRENCY="5"
BULL_MQ_HOST="localhost"
BULL_MQ_PORT="6379"
