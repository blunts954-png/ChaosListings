      "Bash(npm run start:dev:*)",
      "Bash(npm run build:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git add:*)",
      "Bash(timeout 10 tail:*)",
      "Bash(exit 0)",
      "Bash(timeout 15 tail:*)",
      "Bash([ -f .env ])",
      "Bash(npx prisma:*)"
